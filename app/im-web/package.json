{
  "name": "arttalk-desktop",
  "private": true,
  "version": "0.0.15",
  "description": "ArtTalk desktop client",
  "author": "ArtTalk",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:renderer": "vue-tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop": "npm run build:renderer && npm run build:electron && electron-builder --win nsis --x64 --publish never",
    "desktop:preview": "npm run build:renderer && npm run build:electron && electron .",
    "test": "vitest run",
    "verify": "npm run build && npm run build:electron && npm test",
    "audit:runtime": "npm audit --omit=dev --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "electron-updater": "6.8.9",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.8"
  },
  "build": {
    "appId": "com.im.desktop",
    "productName": "ArtTalk",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "artifactName": "ArtTalk-Setup-${version}-${arch}.${ext}",
    "publish": {
      "provider": "generic",
      "url": "https://172.16.59.253:8443/api/v1/update"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/huiyu-root-ca.crt",
        "to": "certs/huiyu-root-ca.crt"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
